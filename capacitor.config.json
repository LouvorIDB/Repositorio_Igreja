{
  "appId": "com.liturge.app",
  "appName": "Liturge",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#070B14",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#070B14",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
